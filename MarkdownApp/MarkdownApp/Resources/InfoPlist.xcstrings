    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Kamerazugriff, um ein Foto aufzunehmen und es als Kontext für das KI-Schreiben anzuhängen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow camera access to take a photo and attach it as context for AI writing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスを許可すると、写真を撮って AI ライティングのコンテキストとして添付できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 접근을 허용하면 사진을 찍어 AI 글쓰기의 컨텍스트로 첨부할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к камере, чтобы сделать снимок и прикрепить его как контекст для ИИ-письма."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问相机，拍照并作为上下文附加到 AI 写作中。"
