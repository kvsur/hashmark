        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達附件數量上限。"
          }
        }
      }
    },
    "Couldn't open the file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei konnte nicht geöffnet werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開けませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 열 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开该文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟該檔案。"
          }
        }
      }
    },
    "Some files are too large to attach.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien sind zu groß zum Anhängen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のファイルは大きすぎて添付できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 파일이 너무 커서 첨부할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые файлы слишком велики для вложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件太大，无法添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分檔案太大，無法加入。"
          }
        }
      }
    },
    "Some files couldn't be added.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien konnten nicht hinzugefügt werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のファイルを追加できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 파일을 추가할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые файлы не удалось добавить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件无法添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分檔案無法加入。"
          }
        }
      }
    },
    "Turn on image and PDF support in AI settings to attach them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Bild- und PDF-Unterstützung in den KI-Einstellungen, um sie anzuhängen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像と PDF を添付するには、AI 設定で対応をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지와 PDF를 첨부하려면 AI 설정에서 지원을 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите поддержку изображений и PDF в настройках ИИ, чтобы прикреплять их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 AI 设置中开启图片与 PDF 支持后才能添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 AI 設定中開啟圖片與 PDF 支援後才能加入。"
          }
        }
      }
    },
    "Allow image and PDF attachments": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild- und PDF-Anhänge erlauben"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像と PDF の添付を許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 및 PDF 첨부 허용"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить вложения изображений и PDF"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许图片与 PDF 附件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許圖片與 PDF 附件"
          }
        }
      }
    },
    "Turn this on only if the endpoint and model you configured support image and PDF input. If unsure, leave it off — you can still reference text documents as context.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie dies nur, wenn der konfigurierte Endpunkt und das Modell Bild- und PDF-Eingabe unterstützen. Im Zweifel ausgeschaltet lassen — Textdokumente können Sie weiterhin als Kontext referenzieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定したエンドポイントとモデルが画像と PDF の入力に対応している場合のみオンにしてください。不明な場合はオフのままにしてください——テキスト文書は引き続きコンテキストとして参照できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성한 엔드포인트와 모델이 이미지 및 PDF 입력을 지원하는 경우에만 켜세요. 확실하지 않으면 꺼 두세요 — 텍스트 문서는 계속 컨텍스트로 참조할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включайте это только если настроенные эндпоинт и модель поддерживают ввод изображений и PDF. Если не уверены, оставьте выключенным — текстовые документы всё равно можно использовать как контекст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你配置的接口和模型支持图片与 PDF 输入时才开启。不确定就先关闭——你仍可引用文本文档作为上下文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當你設定的接口與模型支援圖片與 PDF 輸入時才開啟。不確定就先關閉——你仍可引用文字文件作為上下文。"
          }
        }
      }
    },
    "Describe what you want to create — a plan, a proposal, marketing copy, a recipe, anything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie, was Sie erstellen möchten — einen Plan, ein Konzept, einen Werbetext, ein Rezept, alles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作りたいものを教えてください——計画書、企画書、マーケティング文、レシピなど何でも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 만들고 싶은지 알려주세요 — 계획서, 제안서, 마케팅 문구, 레시피 등 무엇이든."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите, что хотите создать — план, предложение, рекламный текст, рецепт, что угодно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说说你想要什么——一份计划、一个方案、一段营销文案、一道菜谱，什么都可以。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說說你想要什麼——一份計劃、一個方案、一段行銷文案、一道食譜，什麼都可以。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
