    "Could not read the file. It may not be a text file, or access was denied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取文件内容失败，可能没有访问权限或不是文本文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取檔案內容失敗，可能沒有存取權限或不是文字檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。テキストファイルでないか、アクセス権がない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽지 못했습니다. 텍스트 파일이 아니거나 접근 권한이 없을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen werden. Möglicherweise ist es keine Textdatei oder der Zugriff wurde verweigert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать файл. Возможно, это не текстовый файл или нет доступа."
          }
        }
      }
    },
